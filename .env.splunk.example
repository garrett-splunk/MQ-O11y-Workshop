# Splunk Observability Cloud secrets (template only — safe to commit).
# Real credentials go in .env.splunk (gitignored).
#
# Create .env.splunk from this file:
#
#   cd ~/projects/ibm-mq-o11y-lab
#   cp .env.splunk.example .env.splunk
#
# Or in one line from the repo root:
#
#   cp .env.splunk.example .env.splunk
#
# Then edit .env.splunk and replace your-ingest-token-here with an
# ingest-scoped token from Splunk O11y → Organization Settings → Access Tokens.
# Match SPLUNK_REALM and URLs to your org (us0, us1, eu0, etc.).
#
# Verify the file exists (do not print token values):
#
#   test -f .env.splunk && echo "OK: .env.splunk present"
#
# Restart the collector after changes:
#
#   docker compose up -d otel-collector

SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=your-ingest-token-here
SPLUNK_INGEST_URL=https://ingest.us1.signalfx.com
SPLUNK_API_URL=https://api.us1.signalfx.com
# Log Observer OTLP/HEC-style ingest for the collector logs exporter.
# If logs export returns HTTP 404, try the observability.splunkcloud.com variant:
# SPLUNK_LOG_INGEST_URL=https://ingest.us1.observability.splunkcloud.com/v1/log
SPLUNK_LOG_INGEST_URL=https://ingest.us1.signalfx.com/v1/log
