* Idempotent lab connectivity — safe to re-run on every QM start (existing volumes included).
* Requires Linux user "app" in the MQ container (see mq/Dockerfile).
DEFINE CHANNEL(DEV.APP.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) REPLACE
ALTER CHANNEL(DEV.APP.SVRCONN) CHLTYPE(SVRCONN) MCAUSER('app')

ALTER AUTHINFO(SYSTEM.DEFAULT.AUTHINFO.IDPWOS) AUTHTYPE(IDPWOS) ADOPTCTX(YES) CHCKCLNT(OPTIONAL)

SET CHLAUTH(DEV.APP.SVRCONN) TYPE(ADDRESSMAP) DESCR('Splunk O11y lab clients') ADDRESS('*') USERSRC(CHANNEL) ACTION(REPLACE)
SET CHLAUTH('*') TYPE(BLOCKUSER) USERLIST('nobody') DESCR('Block nobody user') ACTION(REPLACE)

SET AUTHREC OBJTYPE(QMGR) PROFILE('self') PRINCIPAL('app') AUTHADD(CONNECT,INQ,DSP,ALT,CTRL,SET,SETALL,SETID,CLR)
SET AUTHREC OBJTYPE(QUEUE) PROFILE('**') PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP,CLR)
SET AUTHREC OBJTYPE(QUEUE) PROFILE('SYSTEM.**') PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP,CLR)
SET AUTHREC OBJTYPE(CHANNEL) PROFILE('**') PRINCIPAL('app') AUTHADD(DSP,INQ,CTRL)
